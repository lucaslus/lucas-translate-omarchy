+    fn is_zh_ui() -> bool {
+        if let Ok(explicit) = std::env::var("LUCAS_UI_LANG") {
+            let trimmed = explicit.trim().to_ascii_lowercase();
+            if !trimmed.is_empty() && trimmed != "auto" {
+                return trimmed.starts_with("zh");
+            }
+        }
+        ["LC_ALL", "LC_MESSAGES", "LANG"]
+            .into_iter()
+            .find_map(|name| {
+                std::env::var(name)
+                    .ok()
+                    .map(|value| value.trim().to_ascii_lowercase())
+                    .filter(|value| !value.is_empty())
+            })
+            .is_some_and(|locale| locale.starts_with("zh"))
+    }
+
+    fn omarchy_theme_css() -> Option<String> {
+        let state_dir = std::env::var_os("XDG_STATE_HOME")
+            .map(std::path::PathBuf::from)
+            .filter(|p| p.is_absolute())
+            .or_else(|| std::env::var_os("HOME").map(|h| std::path::PathBuf::from(h).join(".local/state")))?;
+        let text = std::fs::read_to_string(state_dir.join("omarchy/current/theme/colors.toml")).ok()?;
+        let mut bg = None;
+        let mut fg = None;
+        let mut accent = None;
+        let mut red = None;
+        let hex_luminance = |c: &str| -> f64 {
+            let r = u8::from_str_radix(&c[1..3], 16).unwrap_or(0) as f64 / 255.0;
+            let g = u8::from_str_radix(&c[3..5], 16).unwrap_or(0) as f64 / 255.0;
+            let b = u8::from_str_radix(&c[5..7], 16).unwrap_or(0) as f64 / 255.0;
+            let linear = |v: f64| {
+                if v <= 0.03928 {
+                    v / 12.92
+                } else {
+                    ((v + 0.055) / 1.055).powf(2.4)
+                }
+            };
+            0.2126 * linear(r) + 0.7152 * linear(g) + 0.0722 * linear(b)
+        };
+        for raw_line in text.lines() {
+            let line = raw_line.trim();
+            if line.is_empty() || line.starts_with('#') {
+                continue;
+            }
+            let Some((key, raw)) = line.split_once('=') else {
+                continue;
+            };
+            let key = key.trim();
+            let raw = raw.trim();
+            let val = if let Some(rest) = raw.strip_prefix('"') {
+                rest.split('"').next().unwrap_or("")
+            } else if let Some(rest) = raw.strip_prefix('\'') {
+                rest.split('\'').next().unwrap_or("")
+            } else {
+                raw.split_whitespace().next().unwrap_or("")
+            };
+            let valid_hex = val.len() == 7
+                && val.starts_with('#')
+                && val[1..].bytes().all(|b| b.is_ascii_hexdigit());
+            if !valid_hex {
+                continue;
+            }
+            match key {
+                "background" => bg = Some(val.to_string()),
+                "foreground" => fg = Some(val.to_string()),
+                "accent" => accent = Some(val.to_string()),
+                "red" => red = Some(val.to_string()),
+                _ => {}
+            }
+        }
+        let mut css = String::new();
+        if let Some(ref c) = bg {
+            css.push_str(&format!("@define-color lucas_surface {c};\n"));
+        }
+        if let Some(ref c) = fg {
+            css.push_str(&format!("@define-color lucas_fg {c};\n"));
+        }
+        if let Some(ref c) = accent {
+            let accent_fg = if hex_luminance(c) > 0.179 {
+                match bg.as_deref() {
+                    Some(b) if hex_luminance(b) < 0.15 => b,
+                    _ => "#121212",
+                }
+            } else {
+                "#ffffff"
+            };
+            css.push_str(&format!("@define-color lucas_accent {c};\n"));
+            css.push_str(&format!("@define-color lucas_accent_fg {accent_fg};\n"));
+        }
+        if let Some(ref c) = red {
+            css.push_str(&format!("@define-color lucas_danger {c};\n"));
+        }
+        (!css.is_empty()).then_some(css)
+    }
