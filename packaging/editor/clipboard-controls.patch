+/* Dedicated floating confirm/cancel action pill following the active Omarchy/GTK theme. */
+@define-color lucas_surface @headerbar_bg_color;
+@define-color lucas_fg @headerbar_fg_color;
+@define-color lucas_accent @accent_bg_color;
+@define-color lucas_accent_fg @accent_fg_color;
+@define-color lucas_danger @error_color;
+
+.lucas-action-bar {
+  background-color: alpha(@lucas_surface, 0.94);
+  border: 1px solid alpha(@lucas_fg, 0.2);
+  border-radius: 999px;
+  padding: 5px 6px;
+  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.38);
+}
+
+.lucas-action-bar button {
+  min-height: 30px;
+  padding: 4px 12px;
+  border-radius: 999px;
+  font-size: 13px;
+  font-weight: 600;
+  border: none;
+  box-shadow: none;
+}
+
+.lucas-action-cancel {
+  background-color: alpha(@lucas_fg, 0.09);
+  color: @lucas_fg;
+}
+
+.lucas-action-cancel:hover {
+  background-color: alpha(@lucas_danger, 0.22);
+  color: @lucas_danger;
+}
+
+.lucas-action-confirm {
+  background-color: @lucas_accent;
+  color: @lucas_accent_fg;
+}
+
+.lucas-action-confirm:hover {
+  background-color: shade(@lucas_accent, 1.08);
+  color: @lucas_accent_fg;
+}
